// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PaymentProvider {
  STRIPE
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED
}

enum UserRole {
  FREE
  PAID
}

model User {
  id       String   @id @default(uuid())
  name     String
  email    String   @unique
  role     UserRole @default(FREE)
  password String?

  chat    Chat[]
  user    Post[]
  payment Payment[]
  memory  UserMemory[]

  @@map("users")
}

model Chat {
  id     String @id @default(uuid())
  title  String
  userId String

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  messages Message[]

  @@map("chats")
}

model Message {
  id      String @id @default(uuid())
  role    String
  content String
  chatId  String

  createdAt DateTime @default(now()) @map("created_at")

  chat Chat @relation(fields: [chatId], references: [id])

  @@map("messages")
}

model UserMemory {
  id     String @id @default(uuid())
  userId String

  content String

  embedding Json

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Knowledge {
  id        String @id @default(uuid())
  title     String
  content   String
  embedding Unsupported("vector(768)")

  @@map("knowledges")
}

model Post {
  id     String @id @default(uuid())
  title  String
  contet String

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @default(now()) @map("updated_at")

  postId String?
  userId String?

  user User? @relation(fields: [userId], references: [id])

  @@map("posts")
}

model Payment {
  id      String  @id @default(uuid())
  eventId String? @unique
  userId  String

  externalId         String
  externalCustomerId String?

  amount   Int
  currency String

  status   PaymentStatus
  provider PaymentProvider
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, externalId])
  @@map("payments")
}
