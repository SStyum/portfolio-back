// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PaymentProvider {
  STRIPE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  INCOMPLETE
  CANCELED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED
}

// Plano de assinatura
enum OAuthProvider {
  GITHUB
}

enum UserPlan {
  FREE
  PAID
}

// Permissão de acesso
enum UserRole {
  USER
  ADMIN
}

model User {
  id       String   @id @default(uuid())
  name     String
  email    String   @unique
  plan     UserPlan @default(FREE)
  role     UserRole @default(USER)
  password String?

  emailVerifiedAt DateTime?

  // ID do cliente na API de pagamento (Stripe customer, etc.)
  billingCustomerId String? @unique

  chat     Chat[]
  posts    Post[]
  comments Comment[]
  payment      Payment[]
  subscription  Subscription?
  oauthAccounts OAuthAccount[]
  memory        UserMemory[]

  @@map("users")
}

model Chat {
  id     String @id @default(uuid())
  title  String
  userId String

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  messages Message[]

  @@map("chats")
}

model Message {
  id      String @id @default(uuid())
  role    String
  content String
  chatId  String

  createdAt DateTime @default(now()) @map("created_at")

  chat Chat @relation(fields: [chatId], references: [id])

  @@map("messages")
}

model UserMemory {
  id     String @id @default(uuid())
  userId String

  content String

  embedding Json

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Knowledge {
  id        String @id @default(uuid())
  title     String
  content   String
  embedding Unsupported("vector(768)")

  @@map("knowledges")
}

model Post {
  id      String @id @default(uuid())
  title   String
  content String

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  userId String

  user     User      @relation(fields: [userId], references: [id])
  comments Comment[]

  @@index([createdAt])
  @@map("posts")
}

model Comment {
  id      String @id @default(uuid())
  content String

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  userId String
  postId String

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("comments")
}

model Payment {
  id      String  @id @default(uuid())
  eventId String? @unique
  userId  String

  externalId         String
  externalCustomerId String?

  amount   Int
  currency String

  status   PaymentStatus
  provider PaymentProvider
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, externalId])
  @@map("payments")
}


model Subscription {
  id     String @id @default(uuid())
  userId String @unique

  provider   PaymentProvider
  externalId String

  status            SubscriptionStatus
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean            @default(false)

  // Data do último evento aplicado: webhooks podem chegar fora de ordem
  lastEventAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, externalId])
  @@map("subscriptions")
}

// Login social: uma conta no provedor aponta pra um usuário
model OAuthAccount {
  id                String        @id @default(uuid())
  provider          OAuthProvider
  providerAccountId String
  userId            String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("oauth_accounts")
}
